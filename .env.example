# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# JSON-RPC URL for Sepolia (from Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://sepolia.example-provider.io/v2/YOUR_API_KEY

# Private key of a THROWAWAY test wallet funded with Sepolia test ETH.
# Never use a wallet that holds real funds.
SEPOLIA_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# Optional: wallet that will administer supplier approvals (defaults to the deployer).
# ADMIN_ADDRESS=0x...

# Optional: only if your network blocks binaries.soliditylang.org (official solc download).
# SOLC_JS_PATH=node_modules/solc/soljson.js
